{
  "devDependencies": {
    "fixpack": "4.0.0",
    "prettier": "3.9.10",
    "renovate": "44.150.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.6",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none"
  },
  "private": true,
  "scripts": {
    "fix": "echo fix:fixpack fix:prettier | xargs -n 1 pnpm run",
    "fix:fixpack": "fixpack",
    "fix:prettier": "prettier --write .",
    "test": "echo test:fixpack test:prettier test:renovate-config-validator | xargs -n 1 pnpm run",
    "test:fixpack": "fixpack --dryRun",
    "test:prettier": "prettier --check .",
    "test:renovate-config-validator": "git ls-files -- '*.json' '*.json5' ':!:package*.json' | xargs renovate-config-validator --strict"
  }
}
